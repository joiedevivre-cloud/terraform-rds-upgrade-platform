github_repository        = "GITHUB_OWNER/GITHUB_REPOSITORY"
github_oidc_subject_repository = "" # Or GITHUB_OWNER@OWNER_ID/GITHUB_REPOSITORY@REPOSITORY_ID when customized.
github_oidc_provider_arn = "arn:aws:iam::AWS_ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
create_github_oidc_provider = false
state_bucket_name        = "REPLACE_WITH_STATE_BUCKET"
state_admin_principal_arns = [
  "arn:aws:iam::AWS_ACCOUNT_ID:role/PlatformAdministrator"
]
developer_user_names = ["REPLACE_WITH_DEVELOPER_USER"]
